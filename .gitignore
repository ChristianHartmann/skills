# Output of a skill run, in case one ever lands here. These belong to the
# design question they came from, not to the skill.
#
# Deliberately NOT a pattern like `*-variants/` - that would swallow
# `skills/ui-variants/`, the skill itself. So only concrete file names.
choice.json
history.json

# Built by `show_variants.py --build-only`. The template it is built from
# lives at skills/ui-variants/assets/page-template.html and is tracked.
page.html

# Python
__pycache__/
*.pyc

# Local agent and tooling state. Not ignored globally on a fresh clone, so it
# is named here rather than relying on anyone's personal excludes file.
.claude/settings.local.json
.impeccable/
